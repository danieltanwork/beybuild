# Neon Postgres
DATABASE_URL=

# Neon Auth (Stack) — get these from the Neon console: Project > Auth
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=

# Neon's built-in S3-compatible object storage (Project > Storage, or
# via `create_storage_bucket` / `create_credential` in the Neon MCP tools)
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=
NEON_STORAGE_BUCKET=
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=

# Anthropic API (console.anthropic.com) — used to read box photos
ANTHROPIC_API_KEY=
VISION_MODEL=claude-haiku-4-5-20251001
